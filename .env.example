# Public (safe for the browser). Local values come from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55821
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. NEVER expose to the browser or commit real values.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Optional: used by integration tests / seed scripts only.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55822/postgres

# Test accounts (created by `npm run db:seed:test`). Used by Playwright + integration tests.
E2E_OWNER_EMAIL=owner@coffee.test
E2E_OWNER_PASSWORD=OwnerPass123!
E2E_VIEWER_EMAIL=viewer@coffee.test
E2E_VIEWER_PASSWORD=ViewerPass123!
E2E_INVENTORY_EMAIL=inventory@coffee.test
E2E_INVENTORY_PASSWORD=InventoryPass123!

# Optional: POST unhandled server errors to a webhook (Slack/Discord/Sentry-compatible). Server only.
ERROR_WEBHOOK_URL=
